# Credenciais do usuário master (defina valores fortes na Vercel)
ALPHA_MASTER_USER=alpha
ALPHA_MASTER_PASSWORD=defina-uma-senha-forte
ADMIN_SESSION_SECRET=gere-uma-chave-secreta-longa

# SMTP para envio automático dos orçamentos
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASSWORD=sua-senha-ou-app-password
SMTP_FROM=orcamentos@seudominio.com.br

# Login social Google OAuth
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-uma-chave-secreta-longa
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sua-chave-publica
SUPABASE_SERVICE_ROLE_KEY=sb_secret_somente-no-servidor
