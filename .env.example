# Credenciais do usuário master (nunca use estes exemplos em produção)
ALPHA_MASTER_USER=alpha
ALPHA_MASTER_PASSWORD=gere-uma-senha-forte-com-mais-de-16-caracteres
ADMIN_SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# SMTP para envio automático dos orçamentos
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASSWORD=sua-senha-ou-app-password
SMTP_FROM=orcamentos@seudominio.com.br

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sua-chave-publica
SUPABASE_SERVICE_ROLE_KEY=sb_secret_somente-no-servidor

# Pagamentos Mercado Pago (Pix, cartão de crédito e boleto)
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
MP_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://lojaalphatec.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5548988392308

# Stripe (fallback de cartão/boleto: só é usado se MP_ACCESS_TOKEN estiver vazio)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correios (contrato): pré-postagem e etiqueta oficial com rastreio
CORREIOS_USUARIO=seu-usuario-meu-correios
CORREIOS_CODIGO_ACESSO=codigo-de-acesso-da-api
CORREIOS_CARTAO_POSTAGEM=0000000000
CORREIOS_CONTRATO=0000000000
# 03298 = PAC contrato, 03220 = SEDEX contrato
CORREIOS_CODIGO_SERVICO=03298
# use "homologacao" para testar antes de valer em produção
CORREIOS_AMBIENTE=producao
